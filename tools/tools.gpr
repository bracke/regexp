with "config/regexp_tools_config.gpr";

project Tools is
   for Source_Dirs use (".", "config");
   for Object_Dir use "obj/" & Regexp_Tools_Config.Build_Profile;
   for Exec_Dir use "bin";
   for Create_Missing_Dirs use "True";
   for Main use ("check_all.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        Regexp_Tools_Config.Ada_Compiler_Switches & ("-gnat2022", "-gnatyM120", "-gnatX", "-gnata");
   end Compiler;
   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

end Tools;
