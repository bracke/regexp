with "config/check_regexp_config.gpr";

project Check_Regexp is
   for Source_Dirs use ("src", "config");
   for Object_Dir use "obj/" & Check_Regexp_Config.Build_Profile;
   for Exec_Dir use "bin";
   for Create_Missing_Dirs use "True";
   for Main use ("check_regexp.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        Check_Regexp_Config.Ada_Compiler_Switches & ("-gnat2022", "-gnatyM120", "-gnatX", "-gnata");
   end Compiler;
   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

end Check_Regexp;
